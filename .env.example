# Copia este archivo a .env y completa los valores. NUNCA subas .env a GitHub.
DB_HOST=tu-instancia.xxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=vehiculo_iot
DB_USER=usuario_de_la_api
DB_PASSWORD=cambia_esto
DB_CONNECT_TIMEOUT=5
# Genera una clave nueva:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=cambia_esto
# Opcional (recomendado): cifrar EC2 -> RDS con el bundle de CA de RDS
# DB_SSL_CA=/home/ubuntu/global-bundle.pem
# Orígenes del frontend, separados por coma (solo esquema + dominio, sin ruta ni diagonal final)
CORS_ORIGINS=https://TU_USUARIO.github.io
# --- Práctica 4.3: inicio de sesión con Google y roles ---
# Client ID web de Google (Google Cloud Console > Credenciales). Es público.
GOOGLE_CLIENT_ID=
# Correos (separados por coma) que entran como ADMINISTRADOR. Nunca los subas a GitHub en otro archivo.
ADMIN_EMAILS=
# Minutos de sesión de Admin/Usuario y de la prueba de Invitado
SESION_MINUTOS=480
INVITADO_MINUTOS=5
